# Per-video-project generated/derived media — regenerated fresh on every
# render (locally or via .github/workflows/render.yml), never committed.
# Unlike the small *.json decision files these come from, these grow
# unboundedly per video (hundreds of MB to low GB EACH) and are either
# fully re-derivable (cinematic layers, procedural) or re-resolvable via a
# stable by-ID lookup (broll, via replay-media-choices.mjs) — see
# documentary-broll/SKILL.md's "Rendering in the cloud, free" section.
videos/*/.media/
videos/*/.hyperframes/cinematic-assets/
videos/*/renders/
# Chunked-render sub-projects (see documentary-broll's split-for-chunked-
# render.mjs) are standalone projects nested one level deeper — same
# gitignore reasoning applies at that depth too.
videos/*/.hyperframes/chunks/*/.media/
videos/*/.hyperframes/chunks/*/.hyperframes/cinematic-assets/
videos/*/.hyperframes/chunks/*/renders/
# Intermediate render scratch and source media for the sleep-long-video skill.
# MEASURED on one 47-minute film: .work 7.3 GB (DepthFlow clips, join chunks,
# per-section voice WAVs) and assets 818 MB (narration audio). Both are fully
# re-derivable from the small *.json decision files and the script, and neither
# was covered by the rules above -- a plain `git add -A` in that project would
# have committed 8.1 GB into history.
videos/*/.work/
videos/*/assets/
videos/*/.hyperframes/chunks/*/.work/
videos/*/.hyperframes/chunks/*/assets/
videos/*/.thumbnails/
videos/*/.waveform-cache/
videos/*/transcribe_err.log
videos/*/transcribe.log

# Node
node_modules/
npm-debug.log*

# Playwright MCP tool's own console log dumps — unrelated to any project
.playwright-mcp/

# OS/editor cruft
.DS_Store
*.swp
