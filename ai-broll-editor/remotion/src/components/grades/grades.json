{
  "_comment": "Spec 16.5. `css` = CSS filter applied to the broll layer; `overlay` = extra tint layers (Remotion only); `ffmpeg` = equivalent filter chain. `grain` 0..1 (0 = none), `vignette` always true. Shared by remotion/ and the FFmpeg segment builder. grain raised 2026-09-16: 0 grain is what made mismatched stock read as separate clips; 2-4% luma is the researched band (below 2% invisible, above 6% reads as noise). Blacks lifted ~1% via curves \u2014 the single biggest flat-vs-filmic lever.",
  "vignetteFfmpeg": "vignette=PI/5",
  "grades": {
    "clean-cool": {
      "css": "contrast(1.05) saturate(0.95)",
      "overlay": [
        {
          "color": "rgba(40,90,255,0.04)",
          "blend": "normal"
        }
      ],
      "ffmpeg": "eq=contrast=1.05:saturation=0.95,colorbalance=bs=0.04,curves=all='0/0.012 1/1'",
      "grain": 0.022,
      "vignette": true,
      "letterbox": false
    },
    "warm-film": {
      "css": "sepia(0.12) contrast(1.08)",
      "overlay": [],
      "ffmpeg": "eq=contrast=1.08,colorbalance=rs=0.05:bs=-0.04,noise=alls=6:allf=t",
      "grain": 0.045,
      "vignette": true,
      "letterbox": false
    },
    "teal-orange": {
      "css": "contrast(1.04)",
      "overlay": [
        {
          "color": "linear-gradient(180deg, rgba(0,140,160,0.18) 0%, rgba(0,0,0,0) 55%)",
          "blend": "soft-light"
        },
        {
          "color": "linear-gradient(0deg, rgba(255,140,40,0.18) 0%, rgba(0,0,0,0) 55%)",
          "blend": "soft-light"
        }
      ],
      "ffmpeg": "colorbalance=rs=0.06:bs=0.08:rm=-0.03",
      "grain": 0.028,
      "vignette": true,
      "letterbox": false
    },
    "muted-documentary": {
      "css": "saturate(0.8) contrast(1.03)",
