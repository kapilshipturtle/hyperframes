{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-broll-editor/schemas/assets.schema.json",
  "title": "assets.json",
  "description": "Chosen asset + alternates per beat id. Spec 10.4.",
  "type": "object",
  "propertyNames": {
    "pattern": "^b_[0-9]+"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "chosen": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "assetId": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "video",
                  "image"
                ]
              },
              "source": {
                "type": "string",
                "enum": [
                  "pexels",
                  "openverse",
                  "wikimedia",
                  "nasa",
                  "archiveorg",
                  "youtube",
                  "user"
                ]
              },
              "srcUrl": {
                "type": "string"
              },
              "localPath": {
                "type": "string"
              },
              "preparedPath": {
                "type": "string"
              },
              "inMs": {
                "type": "integer",
                "minimum": 0
              },
              "outMs": {
                "type": "integer",
                "minimum": 0
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "fps": {
                "type": "number",
                "minimum": 0
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0
              },
              "clipScore": {
                "type": "number"
              },
              "sceneScore": {
                "type": "number"
              },
              "license": {
                "type": "string"
              },
              "attribution": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tier": {
                "type": "string",
                "enum": [
                  "stock",
                  "archival",
                  "y1",
                  "y2",
                  "user"
                ]
              },
              "sd": {
                "type": "boolean"
              },
              "channelTitle": {
                "type": "string"
              },
              "sourceVideoId": {
                "type": "string"
              },
              "headPadFrames": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "assetId",
              "kind",
              "source",
              "srcUrl",
              "localPath",
              "inMs",
              "outMs",
              "width",
              "height",
              "clipScore",
              "license",
              "attribution",
              "tier",
              "reasons"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "alternates": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "assetId": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "video",
                "image"
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "pexels",
                "openverse",
                "wikimedia",
                "nasa",
                "archiveorg",
                "youtube",
                "user"
              ]
            },
            "srcUrl": {
              "type": "string"
            },
            "localPath": {
              "type": "string"
            },
            "preparedPath": {
              "type": "string"
            },
            "inMs": {
              "type": "integer",
              "minimum": 0
            },
            "outMs": {
              "type": "integer",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "fps": {
              "type": "number",
              "minimum": 0
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0
            },
            "clipScore": {
              "type": "number"
            },
            "sceneScore": {
              "type": "number"
            },
            "license": {
              "type": "string"
            },
            "attribution": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tier": {
              "type": "string",
              "enum": [
                "stock",
                "archival",
                "y1",
                "y2",
                "user"
              ]
            },
            "sd": {
              "type": "boolean"
            },
            "channelTitle": {
              "type": "string"
            },
            "sourceVideoId": {
              "type": "string"
            },
            "headPadFrames": {
              "type": "integer",
              "minimum": 0
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "assetId",
            "kind",
            "source",
            "srcUrl",
            "localPath",
            "inMs",
            "outMs",
            "width",
            "height",
            "clipScore",
            "license",
            "attribution",
            "tier",
            "reasons"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "chosen",
      "alternates"
    ],
    "additionalProperties": false
  }
}
