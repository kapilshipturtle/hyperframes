{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-broll-editor/schemas/timeline.schema.json",
  "title": "timeline.json",
  "description": "Frame-quantised EDL. Frames only. Spec 10.5.",
  "type": "object",
  "properties": {
    "fps": {
      "type": "integer",
      "const": 30
    },
    "width": {
      "type": "integer",
      "const": 1920
    },
    "height": {
      "type": "integer",
      "const": 1080
    },
    "durationInFrames": {
      "type": "integer",
      "minimum": 1
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "string"
    },
    "narration": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "startFrame": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "src",
        "startFrame"
      ],
      "additionalProperties": false
    },
    "grade": {
      "type": "string",
      "enum": [
        "clean-cool",
        "warm-film",
        "teal-orange",
        "muted-documentary",
        "high-contrast-bw",
        "vibrant",
        "night",
        "vintage"
      ]
    },
    "duckCurve": {
      "type": "string"
    },
    "tracks": {
      "type": "object",
      "properties": {
        "broll": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "beatId": {
                "type": "string"
              },
              "sectionId": {
                "type": "string"
              },
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "durationInFrames": {
                "type": "integer",
                "minimum": 1
              },
              "route": {
                "type": "string",
                "enum": [
                  "ffmpeg",
                  "remotion"
                ]
              },
              "segmentId": {
                "type": "string",
                "pattern": "^seg_[0-9]+$"
              },
              "layout": {
                "type": "string",
                "enum": [
                  "fullscreen-clip",
                  "fullscreen-image-kenburns",
                  "split-left-media-right-text",
                  "split-right-media-left-text",
                  "grid-2",
                  "grid-3",
                  "grid-4",
                  "pip-over-blur",
                  "quote-card",
                  "stat-counter",
                  "list-reveal",
                  "chapter-card",
                  "end-card",
                  "lower-third",
                  "comparison-split",
                  "device-frame",
                  "map-pin",
                  "timeline-strip",
                  "typographic-card"
                ]
              },
              "media": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "src": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "video",
                        "image"
                      ]
                    },
                    "startFromFrame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "label": {
                      "type": "string"
                    },
                    "freezeAfterFrame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "portrait": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "src",
                    "kind",
                    "startFromFrame"
                  ],
                  "additionalProperties": false
                }
              },
              "motion": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "none",
                      "ken-burns",
                      "parallax-drift",
                      "slow-zoom-out",
                      "handheld",
                      "speed-ramp",
                      "freeze-end"
                    ]
                  },
                  "to": {
                    "type": "string",
                    "enum": [
                      "center",
                      "top-left",
                      "top",
                      "top-right",
                      "left",
                      "right",
                      "bottom-left",
                      "bottom",
                      "bottom-right"
                    ]
                  },
                  "zoom": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 2
                  },
                  "peakFrame": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "playbackRate": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 4
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              "transitionIn": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "cut",
                      "fade",
                      "luma-dissolve",
                      "wipe",
                      "slide",
                      "push-blur",
                      "zoom-punch",
                      "whip-pan",
                      "glitch",
                      "flip",
                      "iris",
                      "clockWipe",
                      "light-leak",
                      "film-burn",
                      "shutter",
                      "pixelate"
                    ]
                  },
                  "durationInFrames": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "from-left",
                      "from-right",
                      "from-top",
                      "from-bottom"
                    ]
                  }
                },
                "required": [
                  "type",
                  "durationInFrames"
                ],
                "additionalProperties": false
              },
              "credit": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "corner": {
                        "type": "string",
                        "enum": [
                          "bottom-left",
                          "bottom-right"
                        ]
                      }
                    },
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "grade": {
                "type": "string",
                "enum": [
                  "clean-cool",
                  "warm-film",
                  "teal-orange",
                  "muted-documentary",
                  "high-contrast-bw",
                  "vibrant",
                  "night",
                  "vintage"
                ]
              },
              "gridLabels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "gridStaggerFrames": {
                "type": "integer",
                "minimum": 0
              },
              "stat": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "prefix": {
                    "type": "string"
                  },
                  "suffix": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "countFrames": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "value",
                  "countFrames"
                ],
                "additionalProperties": false
              },
              "quote": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "attribution": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              },
              "listLines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "atFrame": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "text",
                    "atFrame"
                  ],
                  "additionalProperties": false
                }
              },
              "cardTitle": {
                "type": "string"
              },
              "cardSubtitle": {
                "type": "string"
              },
              "keyPhrase": {
                "type": "string"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "stock",
                  "archival",
                  "y1",
                  "y2",
                  "user"
                ]
              }
            },
            "required": [
              "id",
              "beatId",
              "sectionId",
              "from",
              "durationInFrames",
              "route",
              "segmentId",
              "layout",
              "media",
              "motion",
              "transitionIn",
              "credit"
            ],
            "additionalProperties": false
          }
        },
        "text": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "beatId": {
                "type": "string"
              },
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "durationInFrames": {
                "type": "integer",
                "minimum": 1
              },
              "content": {
                "type": "string",
                "minLength": 1
              },
              "style": {
                "type": "string",
                "enum": [
                  "kinetic-bold",
                  "typewriter",
                  "highlight-marker",
                  "lower-third-name",
                  "big-number",
                  "caption-box",
                  "outline-stroke",
                  "gradient-fill",
                  "slide-up-mask",
                  "word-by-word-pop"
                ]
              },
              "position": {
                "type": "string",
                "enum": [
                  "lower-left",
                  "lower-center",
                  "lower-right",
                  "center",
                  "upper-left",
                  "upper-right",
                  "left-panel",
                  "right-panel"
                ]
              },
              "anchorWordId": {
                "type": "integer",
                "minimum": 0
              },
              "wordFrames": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "from": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "durationInFrames": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "text",
                    "from",
                    "durationInFrames"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "beatId",
              "from",
              "durationInFrames",
              "content",
              "style",
              "position",
              "anchorWordId"
            ],
            "additionalProperties": false
          }
        },
        "motiongfx": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "beatId": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "stat-counter",
                  "progress-bar-top",
                  "arrow-callout",
                  "highlight-box",
                  "circle-reveal",
                  "underline-draw",
                  "icon-pop",
                  "particles-light",
                  "bar-chart-mini",
                  "checklist-tick",
                  "corner-credit"
                ]
              },
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "durationInFrames": {
                "type": "integer",
                "minimum": 1
              },
              "params": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "beatId",
              "type",
              "from",
              "durationInFrames",
              "params"
            ],
            "additionalProperties": false
          }
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "src": {
                "type": "string",
                "minLength": 1
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "tag": {
                "type": "string",
                "enum": [
                  "whoosh-soft",
                  "whoosh-hard",
                  "swoosh-short",
                  "pop",
                  "click",
                  "tick",
                  "impact-soft",
                  "glitch",
                  "camera-shutter",
                  "typewriter-key",
                  "riser-short",
                  "ding",
                  "counter-tick-loop"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "from",
              "src",
              "volume",
              "tag",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "music": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "from": {
                "type": "integer"
              },
              "durationInFrames": {
                "type": "integer",
                "minimum": 1
              },
              "src": {
                "type": "string",
                "minLength": 1
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.3
              },
              "fadeInFrames": {
                "type": "integer",
                "minimum": 0
              },
              "fadeOutFrames": {
                "type": "integer",
                "minimum": 0
              },
              "startFromFrame": {
                "type": "integer",
                "minimum": 0
              },
              "sectionIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tag": {
                "type": "string",
                "enum": [
                  "upbeat-corporate",
                  "calm-piano",
                  "tension-drone",
                  "documentary-ambient",
                  "tech-minimal",
                  "hopeful-strings"
                ]
              },
              "loopAtFrames": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "required": [
              "id",
              "from",
              "durationInFrames",
              "src",
              "volume",
              "fadeInFrames",
              "fadeOutFrames",
              "sectionIds",
              "tag"
            ],
            "additionalProperties": false
          }
        },
        "captions": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "style": {
              "type": "string"
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "durationInFrames": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "text": {
                    "type": "string"
                  },
                  "tokens": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string"
                        },
                        "from": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "durationInFrames": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "text",
                        "from",
                        "durationInFrames"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "from",
                  "durationInFrames",
                  "text",
                  "tokens"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "enabled",
            "style",
            "pages"
          ],
          "additionalProperties": false
        },
        "credits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "beatId": {
                "type": "string"
              },
              "tier": {
                "type": "string",
                "enum": [
                  "stock",
                  "archival",
                  "y1",
                  "y2",
                  "user"
                ]
              }
            },
            "required": [
              "source",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "broll",
        "text",
        "motiongfx",
        "sfx",
        "music",
        "captions",
        "credits"
      ],
      "additionalProperties": false
    },
    "placementLog": {
      "type": "string"
    }
  },
  "required": [
    "fps",
    "width",
    "height",
    "durationInFrames",
    "jobId",
    "seed",
    "narration",
    "grade",
    "tracks",
    "placementLog"
  ],
  "additionalProperties": false
}
